# ---------- Зависимости и сборка ----------
node_modules/
dist/
release/
release2/
release-build/
build/*
!build/icon.ico
!build/icon.png
!build/icons/
!build/icons/*
# NSIS-хук: сохраняет пользовательские данные (storage) при обновлении и
# переустановке приложения — подключён через build.nsis.include.
!build/installer.nsh
*.tsbuildinfo
.vite/

# ---------- Логи ----------
*.log

# ---------- Данные приложения (меняются локально) ----------
storage/
# Linux-бинарники движков (ffmpeg/sing-box/yt-dlp/nfqws/zapret) — крупные
# (сотни МБ), скачиваются вручную/через npm run fetch:engines-linux, в
# репозиторий не коммитим, аналогично Windows-движкам выше.
storage_linux/
secrets.json
settings.json
data.json
backups/
*.db
*.sqlite

