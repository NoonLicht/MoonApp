# ---------- Компилируемый JS из TypeScript-исходников ----------
# server/ts/*.ts -> server/*.js (собирается через tsc; исходники в server/ts/)
# ВАЖНО: .d.ts-декларации для JS-модулей (logger/settings) в репозитории:
# без них typecheck в CI падает с TS2307 (Cannot find module './settings').
server/monitor.js
server/jobStore.js
server/fsUtil.js
server/download.js

bb.txt
tc.txt
*.txt

# ---------- Локальные инструкции разработчика (не публикуются) ----------
RELEASE.md

# ---------- Мусор vendor (convertx в сборку не входит) ----------
server/vendor/convertx/

# ---------- Исключения: нужные бинарники идут в репозиторий ----------
# DLL LibreHardwareMonitor (монитор железа) — поставляются в инсталляторе.
!server/vendor/lhm/**
# yt-dlp.exe / sing-box.exe в репозиторий НЕ коммитим (крупные): их скачивает
# `npm run fetch:engines` при сборке инсталлятора (в т.ч. в CI).
# См. scripts/fetch-engines.js.
