# Ключи, вшитые в сборку (генерируются scripts/gen-bundled-keys.mjs из секретов
# CI перед упаковкой инсталлятора). В репозитории их быть не должно.
server/bundled-keys.js
# TG WS Proxy (MTProto→WebSocket для Telegram): TS-исходник server/ts/tgwsproxy.ts
server/tgwsproxy.js
# ИИ-оформление заметок: TS-исходник server/ts/notesAi.ts
server/notesAi.js
# Установка Python-окружения движков озвучки: TS-исходник server/ts/pyEnv.ts
server/pyEnv.js
# Форум-трекер (поиск раздач) и работа с дорожками плеера:
# TS-исходники server/ts/{charset,trackerParse,trackerProviders,trackerScraper,mediaProbe}.ts
server/charset.js
server/trackerParse.js
server/trackerProviders.js
server/trackerScraper.js
server/mediaProbe.js
server/browserCookies.js

bb.txt
tc.txt
*.txt

# ---------- Локальные инструкции разработчика (не публикуются) ----------
RELEASE.md

# ---------- Мусор vendor (convertx в сборку не входит) ----------
server/vendor/convertx/

# ---------- Исключения: нужные бинарники идут в репозиторий ----------
# DLL LibreHardwareMonitor (монитор железа) — поставляются в инсталляторе.
!server/vendor/lhm/**
# yt-dlp.exe / sing-box.exe в репозиторий НЕ коммитим (крупные): их скачивает
# `npm run fetch:engines` при сборке инсталлятора (в т.ч. в CI).
# См. scripts/fetch-engines.js.

# ---------- Локальные SDK для сборки GPU-паков (несколько ГБ, не коммитим) ----------
TensorRT-*/
