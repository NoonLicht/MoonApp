diff --git a/crates/ui-egui/src/i18n.rs b/crates/ui-egui/src/i18n.rs
new file mode 100644
index 0000000..2c78a79
--- /dev/null
+++ b/crates/ui-egui/src/i18n.rs
@@ -0,0 +1,188 @@
+//! Interface language (MoonApp build). English is the language of the source; Russian is looked up
+//! by the exact text just before it is laid out (see `epaint::text::set_translator`), so the
+//! slides' own text, which the canvas draws itself, is never translated.
+//!
+//! The catalog is `ru.tsv`: `English<TAB>Russian` per line, `\n` for a line break. A `{}` in the
+//! English side matches any text (a number, a name) and `{}` or `{1}`, `{2}`… in the Russian side
+//! puts it back, for texts the interface builds with `format!`.
+
+use std::collections::{BTreeSet, HashMap};
+use std::borrow::Cow;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+static RUSSIAN: AtomicBool = AtomicBool::new(false);
+
+const RU_TSV: &str = include_str!("ru.tsv");
+/// Texts looked at before the answer is cached again from scratch.
+const CACHE_CAP: usize = 8192;
+const MISSING_CAP: usize = 4000;
+
+struct Pattern {
+    /// The English literals between the placeholders.
+    parts: Vec<String>,
+    /// The Russian side split at its placeholders: (literal, index of the capture that follows).
+    out: Vec<(String, Option<usize>)>,
+}
+
+struct Catalog {
+    exact: HashMap<String, String>,
+    patterns: Vec<Pattern>,
+}
+
+#[derive(Default)]
+struct State {
+    cache: HashMap<String, Option<String>>,
+    missing: BTreeSet<String>,
+}
+
+fn catalog() -> &'static Catalog {
+    static CATALOG: OnceLock<Catalog> = OnceLock::new();
+    CATALOG.get_or_init(|| {
+        let mut exact = HashMap::new();
+        let mut patterns = Vec::new();
+        for line in RU_TSV.lines() {
+            let line = line.trim_end_matches('\r');
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let Some((en, ru)) = line.split_once('\t') else { continue };
+            let (en, ru) = (en.replace("\\n", "\n"), ru.replace("\\n", "\n"));
+            if en.contains("{}") {
+                patterns.push(pattern(&en, &ru));
+            } else {
+                exact.entry(en).or_insert(ru);
+            }
+        }
+        // The most specific (longest literals) first.
+        patterns.sort_by_key(|p| std::cmp::Reverse(p.parts.iter().map(String::len).sum::<usize>()));
+        Catalog { exact, patterns }
+    })
+}
+
+fn pattern(en: &str, ru: &str) -> Pattern {
+    let parts = en.split("{}").map(str::to_string).collect();
+    let mut out = Vec::new();
+    let mut next = 0;
+    let mut rest = ru;
+    while let Some(open) = rest.find('{') {
+        let Some(close) = rest[open..].find('}') else { break };
+        let tag = &rest[open + 1..open + close];
+        if tag.is_empty() || tag.parse::<usize>().is_ok() {
+            let index = match tag.parse::<usize>() {
+                Ok(n) if n >= 1 => n - 1,
+                _ => {
+                    next += 1;
+                    next - 1
+                }
+            };
+            out.push((rest[..open].to_string(), Some(index)));
+            rest = &rest[open + close + 1..];
+        } else {
+            // Not a placeholder: keep the brace as text.
+            out.push((rest[..=open].to_string(), None));
+            rest = &rest[open + 1..];
+        }
+    }
+    out.push((rest.to_string(), None));
+    Pattern { parts, out }
+}
+
+fn match_pattern<'a>(p: &Pattern, text: &'a str) -> Option<Vec<&'a str>> {
+    let first = p.parts.first()?;
+    let last = p.parts.last()?;
+    if text.len() < first.len() + last.len() || !text.starts_with(first.as_str()) || !text.ends_with(last.as_str()) {
+        return None;
+    }
+    let end = text.len() - last.len();
+    let mut pos = first.len();
+    let mut caps = Vec::new();
+    for lit in &p.parts[1..p.parts.len() - 1] {
+        let at = if lit.is_empty() { pos } else { pos + text[pos..end].find(lit.as_str())? };
+        caps.push(&text[pos..at]);
+        pos = at + lit.len();
+    }
+    caps.push(&text[pos.min(end)..end]);
+    Some(caps)
+}
+
+fn lookup(text: &str) -> Option<String> {
+    let c = catalog();
+    if let Some(t) = c.exact.get(text) {
+        return Some(t.clone());
+    }
+    // Leading or trailing spaces belong to the layout, not to the words.
+    let core = text.trim();
+    if core.len() != text.len() && !core.is_empty() {
+        if let Some(t) = c.exact.get(core) {
+            let lead = &text[..text.len() - text.trim_start().len()];
+            let trail = &text[text.trim_end().len()..];
+            return Some(format!("{lead}{t}{trail}"));
+        }
+    }
+    for p in &c.patterns {
+        let Some(caps) = match_pattern(p, text) else { continue };
+        let mut s = String::new();
+        for (lit, idx) in &p.out {
+            s.push_str(lit);
+            if let Some(i) = idx {
+                let cap = caps.get(*i).copied().unwrap_or("");
+                s.push_str(c.exact.get(cap).map_or(cap, String::as_str));
+            }
+        }
+        return Some(s);
+    }
+    None
+}
+
+fn state() -> &'static Mutex<State> {
+    static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+    STATE.get_or_init(Default::default)
+}
+
+fn translate(text: &str) -> Option<String> {
+    if text.len() < 2 || !text.bytes().any(|b| b.is_ascii_alphabetic()) {
+        return None;
+    }
+    let mut st = state().lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(hit) = st.cache.get(text) {
+        return hit.clone();
+    }
+    if st.cache.len() >= CACHE_CAP {
+        st.cache.clear();
+    }
+    let found = lookup(text);
+    if found.is_none() && st.missing.len() < MISSING_CAP {
+        st.missing.insert(text.to_string());
+    }
+    st.cache.insert(text.to_string(), found.clone());
+    found
+}
+
+/// Switch the interface language: `"ru"` or `"en"` (anything else is English). Returns the code in effect.
+pub fn set_language(code: &str) -> &'static str {
+    RUSSIAN.store(code.eq_ignore_ascii_case("ru"), Ordering::Relaxed);
+    if code.eq_ignore_ascii_case("ru") {
+        egui::epaint::text::set_translator(Some(translate));
+        "ru"
+    } else {
+        egui::epaint::text::set_translator(None);
+        "en"
+    }
+}
+
+/// Texts the interface laid out that the Russian catalog doesn't know (for completing `ru.tsv`).
+pub fn missing() -> Vec<String> {
+    state().lock().unwrap_or_else(|e| e.into_inner()).missing.iter().cloned().collect()
+}
+
+/// `text` in the interface language, for the places that split a label before drawing it
+/// (the layout hook only ever sees the pieces).
+pub fn tr(text: &str) -> Cow<'_, str> {
+    if RUSSIAN.load(Ordering::Relaxed) {
+        if let Some(t) = translate(text) {
+            return Cow::Owned(t);
+        }
+    }
+    Cow::Borrowed(text)
+}
