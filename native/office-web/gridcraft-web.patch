+++ b/apps/gridcraft-web/src/embed.rs
@@ -0,0 +1,140 @@
+//! The host bridge for MoonApp (`?embed`): the page around the frame drives the editor.
+//!
+//! The same protocol as the WordCraft build: the host's glue script (index.html) calls
+//! `window.__wc.call(op, paramsJson, callback)` and `window.__wc.open(name, bytes)`; calls wait in a queue
+//! and are answered between frames. The editor reports back with `postMessage` to the parent:
+//! `ready`, `state` (revision, unsaved flag, active sheet, selection) and `download` (a Save or an export).
+//!
+//! Operations: `run` (`{command, params}` → the app's result, UI commands included), `state`,
+//! `export` (the workbook as .xlsx bytes) and `clean` (the host stored the workbook: clear the unsaved flag).
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::rc::Rc;
+
+use gridcraft_ui_egui::{Inbox, SheetApp};
+use serde_json::{Value, json};
+use wasm_bindgen::JsValue;
+
+pub struct Job {
+    op: String,
+    params: Value,
+    callback: js_sys::Function,
+}
+
+pub type Jobs = Rc<RefCell<VecDeque<Job>>>;
+
+/// The value of `name` in the page's query string (`?embed&lang=ru`); `Some("")` for a bare flag.
+pub fn param(name: &str) -> Option<String> {
+    let search = web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default();
+    search.trim_start_matches('?').split('&').find_map(|kv| {
+        let (k, v) = kv.split_once('=').unwrap_or((kv, ""));
+        (k == name).then(|| v.to_string())
+    })
+}
+
+fn set(obj: &js_sys::Object, key: &str, value: &JsValue) {
+    let _ = js_sys::Reflect::set(obj, &JsValue::from_str(key), value);
+}
+
+/// Tell the page around the frame something: `{wc: 1, evt, ...fields}`.
+fn emit(evt: &str, fields: &[(&str, JsValue)]) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let parent = window.parent().map_err(|e| format!("{e:?}"))?.ok_or("no parent window")?;
+    let msg = js_sys::Object::new();
+    set(&msg, "wc", &JsValue::from_f64(1.0));
+    set(&msg, "evt", &JsValue::from_str(evt));
+    for (k, v) in fields {
+        set(&msg, k, v);
+    }
+    let origin = window.location().origin().map_err(|e| format!("{e:?}"))?;
+    parent.post_message(&msg, &origin).map_err(|e| format!("{e:?}"))
+}
+
+/// A Save or an export goes to the host (which keeps the files) instead of the browser's download.
+pub fn hand_to_host(path: &str, bytes: &[u8]) -> Result<(), String> {
+    let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| path.to_string());
+    emit("download", &[("name", JsValue::from_str(&name)), ("bytes", js_sys::Uint8Array::from(bytes).into())])
+}
+
+pub fn install(jobs: Jobs, inbox: Inbox, ctx: egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let bridge = js_sys::Object::new();
+
+    let wake = ctx.clone();
+    let call = wasm_bindgen::closure::Closure::<dyn FnMut(String, String, js_sys::Function)>::new(move |op: String, params: String, callback: js_sys::Function| {
+        let params = serde_json::from_str(&params).unwrap_or(Value::Null);
+        jobs.borrow_mut().push_back(Job { op, params, callback });
+        wake.request_repaint();
+    });
+    set(&bridge, "call", call.as_ref());
+    call.forget();
+
+    let open = wasm_bindgen::closure::Closure::<dyn FnMut(String, js_sys::Uint8Array)>::new(move |name: String, bytes: js_sys::Uint8Array| {
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes.to_vec()));
+        ctx.request_repaint();
+    });
+    set(&bridge, "open", open.as_ref());
+    open.forget();
+
+    set(&window, "__wc", &bridge);
+    emit("ready", &[])
+}
+
+/// What the host needs to know about the workbook: sheets, selection (for the assistant) and save state.
+fn state(app: &SheetApp) -> Value {
+    let Some(d) = app.session.active() else { return json!({"open": false}) };
+    let sheets: Vec<Value> = d.wb.sheets.iter().enumerate().map(|(i, s)| json!({"i": i, "name": s.name})).collect();
+    json!({
+        "open": true,
+        "doc": {"title": d.title, "path": d.path, "dirty": d.is_dirty(), "revision": d.revision},
+        "sheets": sheets,
+        "active": d.wb.active_sheet,
+        "sel": {"a1": d.selection.a1()},
+    })
+}
+
+fn answer(app: &mut SheetApp, op: &str, params: &Value) -> Result<(Value, Option<Vec<u8>>), String> {
+    match op {
+        "run" => {
+            let id = params.get("command").and_then(Value::as_str).ok_or("missing `command`")?.to_string();
+            let p = params.get("params").cloned().filter(|v| !v.is_null()).unwrap_or(json!({}));
+            Ok((app.run(&id, p)?, None))
+        }
+        "state" => Ok((state(app), None)),
+        "export" => {
+            let d = app.session.active().ok_or("no open workbook")?;
+            let bytes = gridcraft_engine::io::save_bytes(&d.wb, "book.xlsx").map_err(|e| e.to_string())?;
+            Ok((json!({"bytes": bytes.len()}), Some(bytes)))
+        }
+        "clean" => {
+            if let Some(doc) = app.session.active_mut() {
+                doc.saved = doc.wb.clone();
+            }
+            Ok((json!({}), None))
+        }
+        other => Err(format!("unknown operation `{other}`")),
+    }
+}
+
+/// Answer the host's queued calls, then report a changed workbook state.
+pub fn serve(app: &mut SheetApp, jobs: &Jobs, seen: &mut String) {
+    let queued: Vec<Job> = jobs.borrow_mut().drain(..).collect();
+    for job in queued {
+        let reply = match answer(app, &job.op, &job.params) {
+            Ok((v, bytes)) => (json!({"ok": true, "result": v}), bytes),
+            Err(e) => (json!({"ok": false, "error": e}), None),
+        };
+        let json = JsValue::from_str(&reply.0.to_string());
+        let _ = match reply.1 {
+            Some(b) => job.callback.call2(&JsValue::NULL, &json, &js_sys::Uint8Array::from(&b[..]).into()),
+            None => job.callback.call1(&JsValue::NULL, &json),
+        };
+    }
+    let now = state(app);
+    let print = format!("{}|{}|{}|{}", now["doc"]["revision"], now["doc"]["dirty"], now["sel"]["a1"], now["active"]);
+    if print != *seen {
+        *seen = print;
+        let _ = emit("state", &[("state", JsValue::from_str(&now.to_string()))]);
+    }
+}
