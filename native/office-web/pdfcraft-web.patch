@@ -0,0 +1,201 @@
+//! The host bridge for MoonApp (`?embed`): the page around the frame drives the editor.
+//!
+//! The same protocol as the WordCraft, GridCraft and DeckCraft builds: the host's glue script (index.html)
+//! calls `window.__wc.call(op, paramsJson, callback)` and `window.__wc.open(name, bytes)`; calls wait in a
+//! queue and are answered between frames (`PdfCraftApp::embed_tick`). The editor reports back with
+//! `postMessage` to the parent: `ready`, `state` (revision, unsaved flag, page, zoom) and `download`
+//! (a Save or an export).
+//!
+//! Operations: `run` (`{command, params}` → a UI control method such as `ui.command`, `ui.set`,
+//! `ui.state`, `ui.click`), `state`, `export` (the active document as PDF bytes), `clean` (the host stored the
+//! document: clear the unsaved flag).
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::rc::Rc;
+use std::sync::mpsc::Receiver;
+
+use eframe::wasm_bindgen::{JsValue, closure::Closure};
+use pdfcraft_ui_egui::PdfCraftApp;
+use serde_json::{Value, json};
+
+struct Job {
+    op: String,
+    params: Value,
+    callback: js_sys::Function,
+}
+
+#[derive(Default)]
+struct Queue {
+    jobs: VecDeque<Job>,
+    files: Vec<(String, Vec<u8>)>,
+}
+
+/// A control request whose reply is still on its way (answered over later frames).
+struct Waiting {
+    rx: Receiver<Result<Value, String>>,
+    callback: js_sys::Function,
+}
+
+/// The value of `name` in the page's query string (`?embed&lang=ru`); `Some("")` for a bare flag.
+pub fn param(name: &str) -> Option<String> {
+    let search = web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default();
+    search.trim_start_matches('?').split('&').find_map(|kv| {
+        let (k, v) = kv.split_once('=').unwrap_or((kv, ""));
+        (k == name).then(|| v.to_string())
+    })
+}
+
+fn set(obj: &js_sys::Object, key: &str, value: &JsValue) {
+    let _ = js_sys::Reflect::set(obj, &JsValue::from_str(key), value);
+}
+
+/// Tell the page around the frame something: `{wc: 1, evt, ...fields}`.
+fn emit(evt: &str, fields: &[(&str, JsValue)]) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let parent = window.parent().map_err(|e| format!("{e:?}"))?.ok_or("no parent window")?;
+    let msg = js_sys::Object::new();
+    set(&msg, "wc", &JsValue::from_f64(1.0));
+    set(&msg, "evt", &JsValue::from_str(evt));
+    for (k, v) in fields {
+        set(&msg, k, v);
+    }
+    let origin = window.location().origin().map_err(|e| format!("{e:?}"))?;
+    parent.post_message(&msg, &origin).map_err(|e| format!("{e:?}"))
+}
+
+/// What the host needs to know about the open document: name, unsaved flag, revision, page and zoom.
+fn state(app: &PdfCraftApp) -> Value {
+    let Some((index, id)) = app.active_ids() else { return json!({"open": false, "docs": app.views.len()}) };
+    let Some(doc) = app.session.get(id) else { return json!({"open": false, "docs": app.views.len()}) };
+    let view = app.views.get(index);
+    json!({
+        "open": true,
+        "docs": app.views.len(),
+        "doc": {"name": doc.name, "path": doc.path, "dirty": doc.dirty, "revision": doc.edit_generation()},
+        "pages": doc.info.pages.len(),
+        "page": view.map(|v| v.current + 1),
+        "zoom": view.map(|v| v.zoom),
+    })
+}
+
+fn export(app: &PdfCraftApp, params: &Value) -> Result<(Value, Option<Vec<u8>>), String> {
+    let (_, id) = app.active_ids().ok_or("no open document")?;
+    let bytes = app.session.save_bytes(id).map_err(|e| e.to_string())?;
+    let name = params.get("name").and_then(Value::as_str).unwrap_or("document.pdf");
+    Ok((json!({"bytes": bytes.len(), "name": name}), Some(bytes.to_vec())))
+}
+
+fn clean(app: &mut PdfCraftApp) -> Result<(Value, Option<Vec<u8>>), String> {
+    let (_, id) = app.active_ids().ok_or("no open document")?;
+    let bytes = app.session.save_bytes(id).map_err(|e| e.to_string())?;
+    app.session.mark_saved(id, bytes, None).map_err(|e| e.to_string())?;
+    Ok((json!({}), None))
+}
+
+fn reply(callback: &js_sys::Function, reply: (Value, Option<Vec<u8>>)) {
+    let json = JsValue::from_str(&reply.0.to_string());
+    let _ = match reply.1 {
+        Some(b) => callback.call2(&JsValue::NULL, &json, &js_sys::Uint8Array::from(&b[..]).into()),
+        None => callback.call1(&JsValue::NULL, &json),
+    };
+}
+
+/// Wire the app to the page: `window.__wc`, saves handed to the host, language and theme from the query.
+pub fn setup(app: &mut PdfCraftApp, ctx: &egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let queue = Rc::new(RefCell::new(Queue::default()));
+    let bridge = js_sys::Object::new();
+
+    let jobs = queue.clone();
+    let wake = ctx.clone();
+    let call = Closure::<dyn FnMut(String, String, js_sys::Function)>::new(move |op: String, params: String, callback: js_sys::Function| {
+        let params = serde_json::from_str(&params).unwrap_or(Value::Null);
+        jobs.borrow_mut().jobs.push_back(Job { op, params, callback });
+        wake.request_repaint();
+    });
+    set(&bridge, "call", call.as_ref());
+    call.forget();
+
+    let files = queue.clone();
+    let wake = ctx.clone();
+    let open = Closure::<dyn FnMut(String, js_sys::Uint8Array)>::new(move |name: String, bytes: js_sys::Uint8Array| {
+        files.borrow_mut().files.push((name, bytes.to_vec()));
+        wake.request_repaint();
+    });
+    set(&bridge, "open", open.as_ref());
+    open.forget();
+    set(&window, "__wc", &bridge);
+
+    // A Save goes to the host (which keeps the files) instead of the browser's download.
+    app.host_save = Some(Box::new(|name: &str, bytes: &[u8], _save_as: bool| {
+        emit("download", &[("name", JsValue::from_str(name)), ("bytes", js_sys::Uint8Array::from(bytes).into())])
+    }));
+
+    let client = app.attach_control(ctx);
+    if let Some(lang) = param("lang").filter(|l| !l.is_empty()) {
+        let _ = client.send("ui.set", json!({"key": "language", "value": lang}));
+    }
+    if let Some(theme) = param("theme").filter(|t| !t.is_empty()) {
+        let _ = client.send("ui.set", json!({"key": "theme", "value": theme}));
+    }
+
+    let mut waiting: Vec<Waiting> = Vec::new();
+    let mut seen = String::new();
+    app.embed_tick = Some(Box::new(move |app: &mut PdfCraftApp, ctx: &egui::Context| {
+        let (queued, files) = {
+            let mut q = queue.borrow_mut();
+            (q.jobs.drain(..).collect::<Vec<_>>(), std::mem::take(&mut q.files))
+        };
+        for (name, bytes) in files {
+            if let Err(e) = app.open_bytes(&name, None, bytes) {
+                eframe::web_sys::console::error_1(&format!("PdfCraft: could not open {name}: {e}").into());
+            }
+        }
+        for job in queued {
+            let done = match job.op.as_str() {
+                "run" => {
+                    let method = job.params.get("command").and_then(Value::as_str).unwrap_or_default().to_string();
+                    let params = job.params.get("params").cloned().filter(|v| !v.is_null()).unwrap_or(json!({}));
+                    if method.is_empty() {
+                        Err("missing `command`".to_string())
+                    } else {
+                        waiting.push(Waiting { rx: client.send(&method, params), callback: job.callback.clone() });
+                        continue;
+                    }
+                }
+                "state" => Ok((state(app), None)),
+                "export" => export(app, &job.params),
+                "clean" => clean(app),
+                other => Err(format!("unknown operation `{other}`")),
+            };
+            let out = match done {
+                Ok((v, bytes)) => (json!({"ok": true, "result": v}), bytes),
+                Err(e) => (json!({"ok": false, "error": e}), None),
+            };
+            reply(&job.callback, out);
+        }
+        waiting.retain(|w| match w.rx.try_recv() {
+            Ok(Ok(v)) => {
+                reply(&w.callback, (json!({"ok": true, "result": v}), None));
+                false
+            }
+            Ok(Err(e)) => {
+                reply(&w.callback, (json!({"ok": false, "error": e}), None));
+                false
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => true,
+            Err(_) => false,
+        });
+        if !waiting.is_empty() {
+            ctx.request_repaint();
+        }
+        let now = state(app);
+        let print = format!("{}|{}|{}|{}|{}", now["doc"]["revision"], now["doc"]["dirty"], now["page"], now["docs"], now["doc"]["name"]);
+        if print != seen {
+            seen = print;
+            let _ = emit("state", &[("state", JsValue::from_str(&now.to_string()))]);
+        }
+    }));
+    emit("ready", &[])
+}
