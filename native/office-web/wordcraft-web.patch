diff --git a/apps/wordcraft-web/src/web/bridge.rs b/apps/wordcraft-web/src/web/bridge.rs
new file mode 100644
index 00000000..8ab79eed
--- /dev/null
+++ b/apps/wordcraft-web/src/web/bridge.rs
@@ -0,0 +1,155 @@
+//! The host bridge: MoonApp embeds this editor in a frame (`?embed`) and drives it from the page around it.
+//!
+//! The host's glue script (index.html) calls `window.__wc.call(op, paramsJson, callback)` and
+//! `window.__wc.open(name, bytes)`; calls wait in a queue and are answered between frames, so they never
+//! run while the app is in the middle of drawing. The editor reports back with `postMessage` to the parent:
+//! `ready`, `state` (revision, unsaved flag, selection) and `download` (a Save or an export, bytes included).
+//!
+//! Operations: `run` (`{command, params}` → the app's command result, UI commands included), `state`,
+//! `export` (the document as .docx bytes) and `clean` (the host stored the document: clear the unsaved flag).
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::rc::Rc;
+
+use serde_json::{Value, json};
+use wasm_bindgen::JsValue;
+use wordcraft_ui_egui::{Inbox, WordApp};
+
+pub struct Job {
+    op: String,
+    params: Value,
+    callback: js_sys::Function,
+}
+
+pub type Jobs = Rc<RefCell<VecDeque<Job>>>;
+
+/// The value of `name` in the page's query string (`?embed&lang=ru`); `Some("")` for a bare flag.
+pub fn param(name: &str) -> Option<String> {
+    let search = web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default();
+    search.trim_start_matches('?').split('&').find_map(|kv| {
+        let (k, v) = kv.split_once('=').unwrap_or((kv, ""));
+        (k == name).then(|| v.to_string())
+    })
+}
+
+fn set(obj: &js_sys::Object, key: &str, value: &JsValue) {
+    let _ = js_sys::Reflect::set(obj, &JsValue::from_str(key), value);
+}
+
+/// Tell the page around the frame something: `{wc: 1, evt, ...fields}`.
+fn emit(evt: &str, fields: &[(&str, JsValue)]) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let parent = window.parent().map_err(|e| format!("{e:?}"))?.ok_or("no parent window")?;
+    let msg = js_sys::Object::new();
+    set(&msg, "wc", &JsValue::from_f64(1.0));
+    set(&msg, "evt", &JsValue::from_str(evt));
+    for (k, v) in fields {
+        set(&msg, k, v);
+    }
+    let origin = window.location().origin().map_err(|e| format!("{e:?}"))?;
+    parent.post_message(&msg, &origin).map_err(|e| format!("{e:?}"))
+}
+
+/// A Save or an export goes to the host (which keeps the files) instead of the browser's download.
+pub fn hand_to_host(path: &str, bytes: &[u8]) -> Result<(), String> {
+    let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| "document".into());
+    emit("download", &[("name", JsValue::from_str(&name)), ("bytes", js_sys::Uint8Array::from(bytes).into())])
+}
+
+pub fn install(jobs: Jobs, inbox: Inbox, ctx: egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let bridge = js_sys::Object::new();
+
+    let wake = ctx.clone();
+    let call = wasm_bindgen::closure::Closure::<dyn FnMut(String, String, js_sys::Function)>::new(move |op: String, params: String, callback: js_sys::Function| {
+        let params = serde_json::from_str(&params).unwrap_or(Value::Null);
+        jobs.borrow_mut().push_back(Job { op, params, callback });
+        wake.request_repaint();
+    });
+    set(&bridge, "call", call.as_ref());
+    call.forget();
+
+    let open = wasm_bindgen::closure::Closure::<dyn FnMut(String, js_sys::Uint8Array)>::new(move |name: String, bytes: js_sys::Uint8Array| {
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes.to_vec()));
+        ctx.request_repaint();
+    });
+    set(&bridge, "open", open.as_ref());
+    open.forget();
+
+    set(&window, "__wc", &bridge);
+    emit("ready", &[])
+}
+
+/// What the host needs to know about the document: the selection (for the assistant), size and save state.
+fn state(app: &mut WordApp) -> Value {
+    let s = &mut app.session;
+    let sel = s.sel.clone();
+    let mut text = s.selected_text();
+    if text.len() > 20_000 {
+        let mut end = 20_000;
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        text.truncate(end);
+    }
+    let pages = s.layout().pages.len();
+    json!({
+        "selection": {
+            "collapsed": sel.is_collapsed(),
+            "anchor": serde_json::to_value(&sel.anchor).unwrap_or(Value::Null),
+            "focus": serde_json::to_value(&sel.focus).unwrap_or(Value::Null),
+            "text": text,
+        },
+        "pages": pages,
+        "words": s.word_count(),
+        "dirty": s.dirty,
+        "rev": s.rev(),
+        "fileName": s.file_name.clone(),
+        "canUndo": s.can_undo(),
+    })
+}
+
+fn answer(app: &mut WordApp, op: &str, params: &Value) -> Result<(Value, Option<Vec<u8>>), String> {
+    match op {
+        "run" => {
+            let id = params.get("command").and_then(Value::as_str).ok_or("missing `command`")?.to_string();
+            let p = params.get("params").cloned().filter(|v| !v.is_null()).unwrap_or(json!({}));
+            Ok((app.run(&id, p)?, None))
+        }
+        "state" => Ok((state(app), None)),
+        "export" => {
+            let name = params.get("name").and_then(Value::as_str).unwrap_or("document.docx");
+            let bytes = wordcraft_engine::io::save_bytes_opts(name, &app.session.doc, &Default::default())?;
+            Ok((json!({"name": name, "bytes": bytes.len()}), Some(bytes)))
+        }
+        "clean" => {
+            app.session.dirty = false;
+            Ok((json!({}), None))
+        }
+        other => Err(format!("unknown operation `{other}`")),
+    }
+}
+
+/// Answer the host's queued calls, then report a changed document state.
+pub fn serve(app: &mut WordApp, jobs: &Jobs, seen: &mut String) {
+    let queued: Vec<Job> = jobs.borrow_mut().drain(..).collect();
+    for job in queued {
+        let reply = match answer(app, &job.op, &job.params) {
+            Ok((v, bytes)) => (json!({"ok": true, "result": v}), bytes),
+            Err(e) => (json!({"ok": false, "error": e}), None),
+        };
+        let json = JsValue::from_str(&reply.0.to_string());
+        let _ = match reply.1 {
+            Some(b) => job.callback.call2(&JsValue::NULL, &json, &js_sys::Uint8Array::from(&b[..]).into()),
+            None => job.callback.call1(&JsValue::NULL, &json),
+        };
+    }
+    // A cheap fingerprint first: the full state (layout, word count) is built only when something changed.
+    let pos = |p: &wordcraft_doc::Pos| serde_json::to_string(p).unwrap_or_default();
+    let print = format!("{}|{}|{}|{}", app.session.rev(), app.session.dirty, pos(&app.session.sel.anchor), pos(&app.session.sel.focus));
+    if print != *seen {
+        *seen = print;
+        let _ = emit("state", &[("state", JsValue::from_str(&state(app).to_string()))]);
+    }
+}
