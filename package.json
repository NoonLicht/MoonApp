{
  "name": "moonapp",
  "productName": "MoonApp",
  "version": "0.5.0",
  "description": "MoonApp — desktop utility panel (Electron + React + Vite + Node backend)",
  "author": {
    "name": "NoonLicht",
    "email": "moontoon1337@yandex.ru"
  },
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "office:word": "node scripts/buildOfficeWeb.mjs word",
    "office:sheet": "node scripts/buildOfficeWeb.mjs sheet",
    "office:deck": "node scripts/buildOfficeWeb.mjs deck",
    "office:pdf": "node scripts/buildOfficeWeb.mjs pdf",
    "office:photo": "node scripts/buildOfficeWeb.mjs photo",
    "office:sound": "node scripts/buildOfficeWeb.mjs sound",
    "office:fig": "node scripts/buildOfficeWeb.mjs fig",
    "office:effect": "node scripts/buildOfficeWeb.mjs effect",
    "office:film": "node scripts/buildOfficeWeb.mjs film",
    "office:light": "node scripts/buildOfficeWeb.mjs light",
    "compile:server": "tsc -p tsconfig.server.json",
    "build:wordcore": "npm run compile:scripts && node scripts/build-wordcore.mjs",
    "gen:wordcatalog": "npm run compile:scripts && node scripts/genWordCatalog.mjs",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "compile:scripts": "tsc -p tsconfig.scripts.json",
    "compile": "npm run compile:server && npm run compile:electron && npm run compile:scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run compile",
    "start:server": "npm run compile && node server/index.js",
    "fetch:engines": "npm run compile:scripts && node scripts/fetch-engines.js",
    "fetch:models": "npm run compile:scripts && node scripts/fetch-models.js",
    "verify:model": "npm run compile:scripts && node scripts/verify-model.js",
    "profile:mem": "npm run compile && npm run compile:scripts && node scripts/memProfile.js",
    "bench:models": "npm run compile:scripts && node scripts/bench-models.js",
    "bench:cuda": "npm run compile:scripts && node scripts/bench-models.js --providers cuda",
    "bench:trt": "npm run compile:scripts && node scripts/bench-models.js --providers tensorrt",
    "bench:dml": "npm run compile:scripts && node scripts/bench-models.js --providers dml",
    "bench:all": "npm run compile:scripts && node scripts/bench-models.js --providers cuda,tensorrt,dml,cpu",
    "build:ort-gpu": "npm run compile:scripts && node scripts/build-ort-gpu-binding.js",
    "build:gpu-pack": "npm run compile:scripts && node scripts/build-gpu-pack.js",
    "fetch:cuda": "npm run compile:scripts && node scripts/fetch-cuda-libs.js",
    "check:pack": "npm run compile:scripts && node scripts/check-pack.js",
    "gen:keys": "npm run compile:scripts && node scripts/gen-bundled-keys.mjs",
    "start": "npm run compile && npm run build:web && electron .",
    "dist": "npm run compile && npm run build:web && npm run gen:keys && npm run fetch:engines && electron-builder --win && npm run check:pack && npm run rebuild:node",
    "dist:linux": "npm run compile && npm run build:web && npm run gen:keys && electron-builder --linux && npm run rebuild:node",
    "rebuild:electron": "electron-rebuild -f -o better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "pretest": "npm run compile",
    "test:watch": "vitest",
    "test:e2e": "npm run compile && npm run build:web && playwright test",
    "lint": "eslint .",
    "scan:mojibake": "npm run compile:scripts && node scripts/mojibakeScan.mjs",
    "check:i18n": "npm run compile:scripts && node scripts/checkI18n.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:sheetcatalog": "npm run compile:scripts && node scripts/genSheetCatalog.mjs",
    "build:gridcore": "npm run compile:scripts && node scripts/build-gridcore.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/material-symbols-rounded": "^5.3.8",
    "@fontsource/roboto": "^5.3.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@transcribe-cpp/win32-x64-cpu-vulkan": "^0.4.0",
    "@xyflow/react": "^12.11.6",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "curlconverter": "^4.12.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "imapflow": "^2.4.0",
    "isomorphic-git": "^1.42.2",
    "katex": "^0.16.22",
    "mailparser": "^3.9.38",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "motion": "^13.4.4",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.0",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode-generator": "^2.0.4",
    "socks-proxy-agent": "^10.1.0",
    "tesseract.js": "^7.0.0",
    "transcribe-cpp": "^0.4.0",
    "undici": "^6.28.1",
    "webtorrent": "^1.9.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.25",
    "@types/katex": "^0.16.8",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.13.2",
    "jiti": "^2.7.0",
    "lucide-react": "^0.417.0",
    "prettier": "^3.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.moonapp.app",
    "productName": "MoonApp",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!server/vendor/bun/**",
      "!server/vendor/convertx/**",
      "!server/ts/**",
      "!electron/ts/**",
      "!storage/**",
      "!**/settings.json",
      "!**/secrets.json",
      "!**/data.json",
      "!**/data.db*",
      "!**/logs/**",
      "!**/*.log",
      "storage_linux/**"
    ],
    "asarUnpack": [
      "server/vendor/lhm/**",
      "server/vendor/linutil/**",
      "server/vendor/ytdlp/**",
      "server/vendor/singbox/**",
      "server/vendor/proxy-core/**",
      "server/vendor/ffmpeg/**",
      "server/engines/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/transcribe-cpp/**",
      "node_modules/@transcribe-cpp/**",
      "node_modules/koffi/**",
      "storage_linux/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "NoonLicht",
      "repo": "MoonApp",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/sign.js"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "MoonApp-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "artifactName": "MoonApp-${version}.${ext}"
    },
    "deb": {
      "depends": [
        "libsecret-1-0"
      ]
    }
  }
}
