{
  "name": "moonapp",
  "productName": "MoonApp",
  "version": "0.3.2",
  "description": "MoonApp — desktop utility panel (Electron + React + Vite + Node backend)",
  "author": "NoonLicht",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "compile:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run compile:server",
    "start:server": "npm run compile:server && node server/index.js",
    "fetch:engines": "node scripts/fetch-engines.js",
    "fetch:models": "node scripts/fetch-models.js",
    "verify:model": "node scripts/verify-model.js",
    "bench:models": "node scripts/bench-models.js",
    "bench:cuda": "node scripts/bench-models.js --providers cuda",
    "bench:trt": "node scripts/bench-models.js --providers tensorrt",
    "bench:dml": "node scripts/bench-models.js --providers dml",
    "bench:all": "node scripts/bench-models.js --providers cuda,tensorrt,dml,cpu",
    "build:ort-gpu": "node scripts/build-ort-gpu-binding.js",
    "build:gpu-pack": "node scripts/build-gpu-pack.js",
    "fetch:cuda": "node scripts/fetch-cuda-libs.js",
    "check:pack": "node scripts/check-pack.js",
    "gen:keys": "node scripts/gen-bundled-keys.mjs",
    "fetch:whisper": "node scripts/fetch-whisper.js",
    "start": "npm run compile:server && npm run build:web && electron .",
    "dist": "npm run compile:server && npm run build:web && npm run gen:keys && npm run fetch:engines && electron-builder --win && npm run check:pack && npm run rebuild:node",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "pretest": "npm run compile:server",
    "test:watch": "vitest",
    "lint": "eslint .",
    "scan:mojibake": "node scripts/mojibakeScan.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@xyflow/react": "^12.11.6",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.5.0",
    "codemirror": "^6.0.2",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "highlight.js": "^11.12.0",
    "isomorphic-git": "^1.42.2",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "multer": "^2.2.0",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "socks-proxy-agent": "^10.1.0",
    "tesseract.js": "^7.0.0",
    "undici": "^6.28.1",
    "webtorrent": "^1.9.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lucide-react": "^0.417.0",
    "prettier": "^3.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.moonapp.app",
    "productName": "MoonApp",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!server/vendor/bun/**",
      "!server/vendor/convertx/**",
      "!server/ts/**",
      "!storage/**",
      "!**/settings.json",
      "!**/secrets.json",
      "!**/data.json",
      "!**/logs/**",
      "!**/*.log"
    ],
    "asarUnpack": [
      "server/vendor/lhm/**",
      "server/vendor/ytdlp/**",
      "server/vendor/singbox/**",
      "server/vendor/proxy-core/**",
      "server/vendor/ffmpeg/**",
      "server/engines/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "NoonLicht",
      "repo": "MoonApp",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "MoonApp-Setup-${version}.${ext}"
    }
  }
}
