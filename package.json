{
  "name": "personal-app",
  "productName": "PersonalApp",
  "version": "0.1.0",
  "description": "Personal desktop utility panel (Electron + React + Vite + Node backend)",
  "author": "NoonLicht",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "compile:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run compile:server",
    "start:server": "npm run compile:server && node server/index.js",
    "start": "npm run compile:server && npm run build:web && electron .",
    "dist": "npm run compile:server && npm run build:web && electron-builder --win && npm run rebuild:node",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@tiptap/extension-color": "^3.31.0",
    "@tiptap/extension-font-family": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-table-cell": "^3.31.0",
    "@tiptap/extension-table-header": "^3.31.0",
    "@tiptap/extension-table-row": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/extension-text-style": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/html": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@types/dagre": "^0.7.54",
    "@types/turndown": "^5.0.6",
    "@xyflow/react": "^12.11.6",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.5.0",
    "codemirror": "^6.0.2",
    "cors": "^2.8.5",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "elkjs": "^0.12.0",
    "express": "^4.19.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "prosemirror-state": "^1.4.4",
    "smart-buffer": "^4.2.0",
    "socks-proxy-agent": "^10.1.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.personal.app",
    "productName": "PersonalApp",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!server/vendor/bun/**",
      "!server/vendor/convertx/**",
      "!server/ts/**"
    ],
    "asarUnpack": [
      "server/vendor/lhm/**",
      "server/engines/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "NoonLicht",
      "repo": "MoonApp"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PersonalApp-Setup-${version}.${ext}"
    }
  }
}
