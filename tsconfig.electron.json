{
  // Исходники Electron-процессов живут в electron/ts/, компилируются в electron/
  // (main.js, preload.js, storagePath.js) — package.json "main" и require()
  // из серверного кода остаются прежними.
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"],
    "outDir": "electron",
    "rootDir": "electron/ts"
  },
  "include": ["electron/ts/**/*.ts"],
  "exclude": ["node_modules"]
}
