{
  // Служебные скрипты (scripts/ts/*.ts, *.mts) компилируются в scripts/ рядом
  // с .py-файлами: `npm run compile:scripts`, затем обычный `node scripts/x.js`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"],
    "outDir": "scripts",
    "rootDir": "scripts/ts"
  },
  "include": ["scripts/ts/**/*.ts", "scripts/ts/**/*.mts"],
  "exclude": ["node_modules"]
}
