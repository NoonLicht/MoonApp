{
  // Серверные TS-исходники живут в server/ts/, компилируются в server/ (рядом с
  // обычными .js) — существующие require("./monitor") работают без изменений.
  // Явный список "files" нужен, т.к. include-паттерны внутри outDir исключаются tsc.
  // При добавлении новых *.ts допишите их сюда.
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"],
    "outDir": "server",
    "rootDir": "server/ts"
  },
  "files": [
    "server/ts/config.ts",
    "server/ts/logger.ts",
    "server/ts/settings.ts",
    "server/ts/monitor.ts",
    "server/ts/jobStore.ts",
    "server/ts/fsUtil.ts",
    "server/ts/download.ts",
    "server/ts/setupTask.ts",
    "server/ts/frontmatter.ts",
    "server/ts/security.ts",
    "server/ts/elevate.ts",
    "server/ts/backup.ts",
    "server/ts/downloads.ts",
    "server/ts/comss.ts",
    "server/ts/proxySubscriptions.ts",
    "server/ts/proxyPing.ts",
    "server/ts/winget.ts",
    "server/ts/notes-fs.ts",
    "server/ts/torrent.ts",
    "server/ts/ruNlp.ts",
    "server/ts/db.ts",
    "server/ts/logBundle.ts",
    "server/ts/myspace-vault.ts",
    "server/ts/convertEngine.ts",
    "server/ts/index.ts",
    "server/ts/bookParser.ts",
    "server/ts/tmdb.ts",
    "server/ts/encoders.ts",
    "server/ts/vad.ts",
    "server/ts/diarize.ts"
  ]
}
